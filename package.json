{
  "name": "interlagos-3d-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visualizador 3D interativo do Autódromo José Carlos Pace (Interlagos)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:osm": "node scripts/fetch-osm.mjs",
    "data:elevation": "node scripts/fetch-elevation.mjs srtm30m",
    "data:build": "node scripts/build-data.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
